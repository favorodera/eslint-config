{
  "files.autoSave": "afterDelay",
  "git.autofetch": true,
  "editor.tabSize": 2,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "on"
  },
  "eslint.format.enable": true,
  "editor.detectIndentation": false,
  "editor.indentSize": "tabSize",
  "files.eol": "\n",
  "eslint.runtime": "node",
  "npm.packageManager": "pnpm",
  "cSpell.ignorePaths": [
    "package-lock.json",
    "node_modules",
    "vscode-extension",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".vscode",
    ".vscode-insiders",
    ".gitignore",
    ".gitattributes",
    "pnpm-lock.yaml"
  ],
  "eslint.validate": [
    "javascript",
    "vue",
    "typescript",
    "json",
    "jsonc",
    "json5",
    "html",
    "markdown",
    "yaml",
    "yml",
    "mdc"
  ],
  "cSpell.words": [
    "behaviour",
    "commonmark",
    "cssicorn",
    "csstree",
    "defu",
    "demi",
    "Emeka",
    "ependencies",
    "esbuild",
    "favorodera",
    "frontmatter",
    "licence",
    "nonblock",
    "onchange",
    "prebuild",
    "preid",
    "premajor",
    "preminor",
    "prepatch",
    "relizy",
    "tsdown",
    "typegen",
    "unrs",
    "vite",
    "vitest",
    "vuejs"
  ]
}