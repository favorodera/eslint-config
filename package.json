{
  "name": "@favorodera/eslint-config",
  "type": "module",
  "version": "2.0.1",
  "private": false,
  "packageManager": "pnpm@12.14.0",
  "description": "An opinionated,type-safe ESLint flat configuration for JavaScript and TypeScript projects.",
  "author": "Favour Emeka <favorodera@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/favorodera",
  "homepage": "https://github.com/favorodera/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favorodera/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/favorodera/eslint-config/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "tooling",
    "linter",
    "favorodera"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./globs": "./dist/globs.mjs",
    "./types": "./dist/types.mjs",
    "./utils": "./dist/utils.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": ["dist"],
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "typegen": "tsx scripts/typegen.ts",
    "dev:inspector": "eslint --inspect-config",
    "build": "pnpm typegen && tsdown",
    "dev": "pnpm typegen && concurrently \"tsdown --watch\" \"pnpm dev:inspector\"",
    "test": "vitest run",
    "test:watch": "vitest --watch --ui",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ready": "pnpm install && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "dependencies": {
    "@eslint/css": "catalog:",
    "@eslint/js": "catalog:",
    "@eslint/markdown": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "defu": "catalog:",
    "eslint-cssicorn": "catalog:",
    "eslint-flat-config-utils": "catalog:",
    "eslint-merge-processors": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-import-lite": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-jsonc": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-pnpm": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "eslint-plugin-vuejs-accessibility": "catalog:",
    "eslint-plugin-yml": "catalog:",
    "eslint-processor-vue-blocks": "catalog:",
    "globals": "catalog:",
    "tailwind-csstree": "catalog:",
    "typescript-eslint": "catalog:",
    "vue-eslint-parser": "catalog:",
    "yaml-eslint-parser": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/google": "catalog:",
    "@eslint/config-inspector": "catalog:",
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "ai": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "eslint-typegen": "catalog:",
    "pkg-pr-new": "catalog:",
    "relizy": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
